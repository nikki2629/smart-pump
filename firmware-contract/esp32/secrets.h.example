#pragma once

// Copy this file to secrets.h and fill in local values.
// Never commit secrets.h.

// Wi-Fi
#define WIFI_SSID "your-wifi-ssid"
#define WIFI_PASSWORD "your-wifi-password"

// Django pairing API (no trailing slash after api/v1)
// Example LAN: "http://10.84.133.144:8000/api/v1"
// Production:  "https://api.your-domain.com/api/v1"
#define API_BASE_URL "http://10.84.133.144:8000/api/v1"

// From the mobile app "Pair device" screen (one-time, expires in 15 minutes)
#define DEVICE_SERIAL_NUMBER "PANEL-DEVICE-001"
#define DEVICE_PAIRING_CODE "paste-one-time-pairing-code-here"

// MQTT broker (TLS). Username is always the paired device UUID from the API.
// Create that broker user with THIS password after pairing succeeds.
#define MQTT_HOST "10.84.133.144"
#define MQTT_PORT 8883
#define MQTT_PASSWORD "unique-device-broker-password"

// Optional: PEM CA for the MQTT broker. Leave empty to use the ESP root store
// only when your broker uses a publicly trusted certificate.
// For the local simulator CA, paste the contents of ca.crt between the quotes
// (keep the \\n escapes), or set MQTT_INSECURE_SKIP_CERT_VERIFY to 1 for lab only.
#define MQTT_CA_CERT \
  "-----BEGIN CERTIFICATE-----\n" \
  "REPLACE_WITH_CA_PEM\n" \
  "-----END CERTIFICATE-----\n"

// Lab-only. Never enable on a production panel.
#define MQTT_INSECURE_SKIP_CERT_VERIFY 0

// GPIO: start/stop output and optional auxiliary contactor feedback input
#define PIN_MOTOR_RELAY 26
#define PIN_AUX_FEEDBACK 27
#define AUX_FEEDBACK_ACTIVE_HIGH 1

#define FIRMWARE_VERSION "esp32-1.0.0"
